# ============================================
# Personal TV Display – API Keys
# Copy this file to `.env` and fill in your keys.
# All modules fall back to mock data if a key is missing.
# ============================================

# OpenWeather (https://openweathermap.org/api) — used by Header weather
VITE_OPENWEATHER_API_KEY=
VITE_WEATHER_LAT=42.8864
VITE_WEATHER_LON=-78.8784
VITE_WEATHER_UNITS=imperial

# NewsAPI (https://newsapi.org) — used by News widget
VITE_NEWSAPI_KEY=
VITE_NEWS_COUNTRY=us

# Google OAuth (Calendar + Gmail) — see README for Google Cloud Console setup
# Authorized JavaScript origins must include http://localhost:5173 AND
# the LAN IP you use on the TV (e.g. http://192.168.1.100:5173).
VITE_GOOGLE_CLIENT_ID=812118282219-crhsi731r4ad0toqnjasofcef0rehke0.apps.googleusercontent.com
