{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "VITE_GOOGLE_CLIENT_ID": "812118282219-crhsi731r4ad0toqnjasofcef0rehke0.apps.googleusercontent.com"
    }
  },
  "functions": {
    "api/sports-news.js": { "maxDuration": 30 },
    "api/arby.js": { "maxDuration": 15 },
    "api/daily-brief.js": { "maxDuration": 20 }
  },
  "rewrites": [
    { "source": "/api/nhl/:path*", "destination": "/api/nhl?path=:path*" },
    { "source": "/((?!api/).*)",  "destination": "/index.html" }
  ]
}
